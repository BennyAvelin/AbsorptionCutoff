    given-names: Benny
    affiliation: "Department of Mathematics, Uppsala University"
    email: "benny.avelin@math.uu.se"
keywords:
  - Lean
  - mathlib
  - formal verification
  - cutoff phenomenon
  - random dynamical systems
  - Markov chains
  - probability
license: Apache-2.0
