/.lake
.DS_Store

# Local environment and credential files (keep documented examples trackable)
.env
.env.*
!.env.example
*.pem
*.key

# Blueprint render artifacts (regenerated by `leanblueprint web`/`pdf`)
/blueprint/web/
/blueprint/print/
/blueprint/src/web.paux
/blueprint/src/aux/
/blueprint/src/print.pdf
/blueprint/src/print.synctex.gz

# Standalone Chapter 3 proof-note build artifacts
/CH3_FIRST_PASSAGE_CLT_PROOF.pdf
/CH3_FIRST_PASSAGE_CLT_PROOF.synctex.gz
/aux/CH3_FIRST_PASSAGE_CLT_PROOF.*

# Companion note build artifacts
/notes/aux/
/notes/*.pdf
